import torch
import torch.nn as nn

class Predictor(nn.Module):
    def __init__(self):
        super().__init__()
        self.lstm = nn.LSTM(4, 32, batch_first=True)
        self.fc = nn.Linear(32, 2)
    def forward(self, x):
        _, (h, _) = self.lstm(x)
        return self.fc(h[-1])

m = Predictor()
torch.onnx.export(m, torch.randn(1, 10, 4), "predictor.onnx")
